{
  "sourceCatalog": "~/codespace/docs/acceptance/platform-catalog.json",
  "scope": "platform-basic",
  "applicationSuites": [
    "~/codespace/docs/device-management/README.md",
    "~/codespace/docs/chess-room-booking/README.md"
  ],
  "assets": [
    {
      "id": "login-browser",
      "path": "~/codespace/docs/scripts/live-login-regression.cjs",
      "layer": "browser",
      "limitation": "需本机CDP、私密账号文件和候选指纹；缺首次改密、三宽度及CAS独立会话回读。"
    },
    {
      "id": "registration-api",
      "path": "~/codespace/magicTest/cas/registration_test.py",
      "layer": "api",
      "limitation": "已抽查批准前后登录分支；需核对当前认证合同、驳回、重复审批及清理回读。",
      "target": "cas-registration"
    },
    {
      "id": "registration-browser",
      "path": "~/codespace/magicTest/ui/portal_registration_ui_test.py",
      "layer": "browser",
      "limitation": "需Playwright；缺依赖可能跳过；逐项断言和当前认证合同待审。",
      "target": "portal-registration-ui"
    },
    {
      "id": "cas-api",
      "path": "~/codespace/magicTest/cas/cas_api_test.py",
      "layer": "api",
      "limitation": "仅定位候选入口；原主体、当前角色和精确租户／实例断言待审。",
      "target": "cas-api"
    },
    {
      "id": "panel-definition",
      "path": "~/codespace/magicTest/panel/definition_test.py",
      "layer": "api",
      "limitation": "已抽查：定义查询和描述往返；缺图标、发布、独立回读及清理确认；公共夹具仍有旧凭据入口。",
      "target": "panel-governance-api"
    },
    {
      "id": "panel-runtime",
      "path": "~/codespace/magicTest/panel/apps_runtime_test.py",
      "layer": "api",
      "limitation": "已抽查：元数据与列表；自动发现或缺夹具可跳过，未覆盖完整CRUD。",
      "target": "panel-runtime-api"
    },
    {
      "id": "panel-lifecycle-list",
      "path": "~/codespace/magicTest/panel/application_lifecycle_test.py",
      "layer": "api",
      "limitation": "已抽查：只查询运行列表，不能证明安装、启停、卸载或恢复。",
      "target": "panel-runtime-api"
    },
    {
      "id": "panel-subscription",
      "path": "~/codespace/magicTest/panel/subscription_test.py",
      "layer": "api",
      "limitation": "候选查询、端点往返及状态切换；真实ApiKey、到期及撤权待审。",
      "target": "panel-governance-api"
    },
    {
      "id": "panel-service",
      "path": "~/codespace/magicTest/panel/service_roundtrip_test.py",
      "layer": "api",
      "limitation": "已抽查：仍以endpoint/authToken和bind_auth_secret接入；需按当前ApiKey合同改写后验证。",
      "target": "panel-service-api"
    },
    {
      "id": "key-first-call",
      "path": "~/codespace/docs/scripts/live-api-key-first-call.cjs",
      "layer": "browser-api",
      "limitation": "已有ApiKey签发后首次GET；固定local.vpc、已登录页及清理判定须复核，缺轮换／撤销后拒绝证明。"
    },
    {
      "id": "panel-context",
      "path": "~/codespace/magicTest/panel/system_context_test.py",
      "layer": "api",
      "limitation": "候选system/context投影；不是CAS独立授权真值回读。",
      "target": "panel-page-api"
    },
    {
      "id": "panel-profile",
      "path": "~/codespace/magicTest/panel/profile_test.py",
      "layer": "api",
      "limitation": "候选profile结构检查；不证明完整通知、待办和工作台交互。",
      "target": "panel-page-api"
    },
    {
      "id": "base-api",
      "path": "~/codespace/magicTest/platform/run_tests.py",
      "layer": "api",
      "limitation": "旧核心接口集合；逐项核对当前Base SDK／权限及数据归属后再复用。",
      "target": "platform-core-api"
    },
    {
      "id": "file-api",
      "path": "~/codespace/magicTest/file/basic_scenario_test.py",
      "layer": "api",
      "limitation": "文件基础场景；当前认证、受管引用、上传中断和删除证明待审。",
      "target": "file-basic"
    },
    {
      "id": "native-source",
      "path": "~/codespace/magicRunner/internal/modules/kernel/panel/biz/native_orchestration_validation_test.go",
      "layer": "source",
      "limitation": "源码保护项候选；不能替代实际多容器运行／注入与卸载。"
    },
    {
      "id": "deployment-source",
      "path": "~/codespace/magicRunner/internal/modules/kernel/panel/biz/deployment_execution_checkpoint_test.go",
      "layer": "source",
      "limitation": "执行检查点源码保护项候选；原任务、失联及重启Live链路另验。"
    },
    {
      "id": "recovery-source",
      "path": "~/codespace/magicRunner/internal/modules/kernel/panel/biz/application_successor_recovery_test.go",
      "layer": "source",
      "limitation": "后继恢复源码候选；完整恢复用例还需创建当次任务、执行正式恢复并独立核对终态及残留。"
    },
    {
      "id": "deployment-regression",
      "path": "~/dataspace/magicPlatform/tests/deployment/inventory.json",
      "layer": "source-inventory",
      "limitation": "25个当前部署回归文件；执行条件见同目录README，不自动执行，不代表平台功能用例已覆盖或Live通过。"
    },
    {
      "id": "evidence-validator",
      "path": "~/codespace/docs/scripts/platform_acceptance.py",
      "layer": "tool",
      "limitation": "校验目录及结果证据；不是业务场景执行器。"
    }
  ],
