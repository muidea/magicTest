      "target": "platform-core-api"
    },
    {
      "id": "file-api",
      "path": "~/codespace/magicTest/file/basic_scenario_test.py",
      "layer": "api",
      "limitation": "文件基础场景；当前认证、受管引用、上传中断和删除证明待审。",
      "target": "file-basic"
    },
    {
      "id": "native-source",
      "path": "~/codespace/magicRunner/internal/modules/kernel/panel/biz/native_orchestration_validation_test.go",
      "layer": "source",
      "limitation": "源码保护项候选；不能替代实际多容器运行／注入与卸载。"
    },
    {
      "id": "deployment-source",
      "path": "~/codespace/magicRunner/internal/modules/kernel/panel/biz/deployment_execution_checkpoint_test.go",
      "layer": "source",
      "limitation": "执行检查点源码保护项候选；原任务、失联及重启Live链路另验。"
    },
    {
      "id": "recovery-source",
      "path": "~/codespace/magicRunner/internal/modules/kernel/panel/biz/application_successor_recovery_test.go",
      "layer": "source",
      "limitation": "后继恢复源码候选；完整恢复用例还需创建当次任务、执行正式恢复并独立核对终态及残留。"
    },
    {
      "id": "deployment-regression",
      "path": "~/dataspace/magicPlatform/tests/deployment/inventory.json",
      "layer": "source-inventory",
      "limitation": "26个当前部署回归文件；执行条件见同目录README，不自动执行，不代表平台功能用例已覆盖或Live通过。"
    },
    {
      "id": "evidence-validator",
      "path": "~/codespace/docs/scripts/platform_acceptance.py",
      "layer": "tool",
      "limitation": "校验目录及结果证据；不是业务场景执行器。"
    },
    {
      "id": "platform-standard-orchestrator",
      "path": "~/codespace/magicTest/regression/run_standard.py",
      "layer": "tool",
      "target": "platform-standard",
      "limitation": "仅编排常规预检、执行、owner清理与证据报告；未实现分项仍受阻，不表示完整覆盖，不触发条件专项。"
    },
    {
      "id": "platform-standard-handlers",
      "path": "~/codespace/magicTest/regression/standard_cases.cjs",
      "layer": "browser-api",
      "target": "platform-standard",
      "limitation": "只执行实际登记断言；分类只读主体等缺合同项保持受阻。handler登记及本地通过数均不作为稳定全量资格。"
    },
    {
      "id": "platform-standard-identity",
      "path": "~/codespace/magicTest/regression/identity_cases.cjs",
      "layer": "browser-api",
      "target": "platform-standard",
      "limitation": "首次改密、错误密码、精确BFF退出和模板授权生命周期；CAS OAuth会话目录使用同租户真实审计主体。以当轮完整逐步证据和清理门禁为准，未覆盖其他身份分项。"
    },
    {
      "id": "platform-standard-registration",
      "path": "~/codespace/magicTest/regression/registration_cases.cjs",
      "layer": "browser-api",
      "target": "platform-standard",
      "limitation": "匿名租户Host策略与申请、审批／驳回、重复／并发审批及受控初始权限；真实入口未通过时保持开放，不以管理代理替代匿名申请。"
    },
    {
      "id": "platform-standard-session",
      "path": "~/codespace/magicTest/regression/session_cases.cjs",
      "layer": "browser-api",
      "target": "platform-standard",
      "limitation": "常规策略继承／覆盖／重置和精确BFF新旧会话期限；平台策略条件恢复并独立回读，自然到期仍单列专项。"
    },
    {
      "id": "platform-standard-script",
      "path": "~/codespace/magicTest/regression/script_cases.cjs",
      "layer": "browser-api",
      "target": "platform-standard",
      "limitation": "作者脚本格式化、样例执行、日志／定位诊断、正式库保存回读，以及1—3000ms调试预算与传输取消；服务端取消由源码证据独立证明，不代替Base运行绑定或实例持久执行。"
    },
    {
      "id": "platform-standard-notification",
      "path": "~/codespace/magicTest/regression/notification_cases.cjs",
      "layer": "browser-api",
      "target": "platform-standard",
      "limitation": "通知发布、真实门户详情、受众及租户边界、下线／删除与失败时旧缓存保护；使用当前运行独立租户，正式回收。"
    },
    {
      "id": "platform-standard-public-probe",
      "path": "~/codespace/magicTest/regression/public_probe.cjs",
      "layer": "browser-api",
      "target": "platform-standard",
      "limitation": "原主体同源GET首跳及Location；不跟随跳转，不从最终404推断原路径404。"
    },
    {
      "id": "platform-standard-negative-mutations",
      "path": "~/codespace/magicTest/regression/negative_mutations.cjs",
      "layer": "tool",
      "target": "platform-standard",
      "limitation": "负例意图先持久化；已证副作用精确回收／条件恢复；未知及并发变化保持未清理，不代表Live成功。"
    },
    {
      "id": "platform-standard-public-probe-test",
      "path": "~/codespace/magicTest/regression/public_probe.test.cjs",
      "layer": "tool",
      "target": "platform-standard",
      "limitation": "真实Chromium隔离首跳、原Cookie与同源边界；仅工具验证。"
    },
    {
      "id": "platform-standard-negative-mutations-test",
      "path": "~/codespace/magicTest/regression/negative_mutations.test.cjs",
      "layer": "tool",
      "target": "platform-standard",
      "limitation": "越权意外成功／未知／并发及handler夹具；仅工具验证，持久owner与Live另验。"
    },
    {
      "id": "platform-standard-directory",
      "path": "~/codespace/magicTest/regression/directory.cjs",
      "layer": "tool",
      "target": "platform-standard",
      "limitation": "完整分页、原主体与租户、预算和重复身份检查；没有owner快照修订时不承诺并发原子快照，不将不完整结果当作不存在。"
    },
    {
      "id": "platform-standard-resource-lifecycle",
      "path": "~/codespace/magicTest/regression/resource_lifecycle.cjs",
      "layer": "tool",
      "target": "platform-standard",
      "limitation": "公共create/createAs发送前持久化私密意图，独立owner读确认；未知创建／删除不盲重放，未解决子项阻止父租户清理；不覆盖手写业务命令的所有恢复合同。"
    },
    {
      "id": "platform-standard-service-identity",
      "path": "~/codespace/magicTest/regression/service_cases.cjs",
      "layer": "browser-api",
      "target": "platform-standard",
      "limitation": "F037-003重复标识及身份不可编辑的精确拒绝，完整目录与两个独立owner回读；不调用外部上游，不覆盖其余服务主链。"
    }
