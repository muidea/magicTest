        "when": {
          "field": "effectiveTo",
          "present": true
        }
      }
    ]
  },
  "bookingSample": {
    "assertions": [
      {
        "key": "store-merchant",
        "left": [
          "storeId",
          "merchantId"
        ],
        "right": [
          "merchantId"
        ]
      },
      {
